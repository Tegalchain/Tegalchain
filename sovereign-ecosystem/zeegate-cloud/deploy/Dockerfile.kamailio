# Zeegate lab Kamailio — ghcr.io base + db_text (and peers) from deb-archive.
# The ghcr image ships a slim module set; auth_db/db_text/dispatcher live in the
# main kamailio deb (deb-archive.kamailio.org), not kamailio-dbtext-modules.
FROM ghcr.io/kamailio/kamailio:5.8.7-bookworm

USER root

ARG KAMAILIO_DEB=https://deb-archive.kamailio.org/repos/kamailio-5.8.7/pool/main/k/kamailio/kamailio_5.8.7+bpo12_amd64.deb

RUN apt-get update \
    && apt-get install -y --no-install-recommends wget ca-certificates \
    && wget -q -O /tmp/kamailio.deb "${KAMAILIO_DEB}" \
    && dpkg-deb -x /tmp/kamailio.deb /tmp/kamailio-pkg \
    && cp -a /tmp/kamailio-pkg/usr/lib/x86_64-linux-gnu/kamailio/modules/. \
        /usr/lib/x86_64-linux-gnu/kamailio/modules/ \
    && rm -rf /tmp/kamailio.deb /tmp/kamailio-pkg \
    && apt-get purge -y wget \
    && rm -rf /var/lib/apt/lists/*

USER kamailio
