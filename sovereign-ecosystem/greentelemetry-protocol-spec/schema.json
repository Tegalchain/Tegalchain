{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Shootle/sovereign-ecosystem/greentelemetry-protocol-spec/schema.json",
  "title": "GreentelemetryProtocol",
  "description": "Greentelemetry protocol v1.3.0 — canonical TP-101 GreenTelemetry Record (GTR) or legacy SovereignNodeTelemetry envelope. See docs/standards/TP-101-GREENTELEMETRY.md.",
  "oneOf": [
    { "$ref": "#/definitions/green_telemetry_record_v1" },
    { "$ref": "#/definitions/sovereign_node_telemetry" }
  ],
  "definitions": {
    "uuid_v4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "iso8601_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "geo_point": {
      "description": "WGS-84 GeoPoint for measurement source location.",
      "type": "object",
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "altitude_m": { "type": "number" }
      },
      "required": ["latitude", "longitude"],
      "additionalProperties": false
    },
    "attestation": {
      "description": "TP-101 attestation — Ed25519 signature (64 bytes, hex on wire) over GTR canonical hash.",
      "type": "object",
      "properties": {
        "attester_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "attester_type": {
          "enum": ["DEVICE", "OPERATOR", "THIRD_PARTY", "REGULATORY"]
        },
        "signature": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{128}$",
          "description": "64-byte Ed25519 signature encoded as hex"
        },
        "timestamp": { "$ref": "#/definitions/iso8601_timestamp" },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "multipleOf": 0.01
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true,
          "description": "Optional; legacy_sig and algorithm for RSA/ECDSA-P256 attestations"
        }
      },
      "required": ["attester_id", "attester_type", "signature", "timestamp"],
      "additionalProperties": false
    },
    "measurement_type": {
      "enum": [
        "CO2E",
        "CH4",
        "N2O",
        "ENERGY_KWH",
        "ENERGY_MJ",
        "WATER_M3",
        "BIODIVERSITY",
        "OFFSET_CREDIT",
        "CUSTOM"
      ]
    },
    "source_type": {
      "enum": ["SENSOR", "MANUAL", "CERTIFIED_AUDITOR", "API"]
    },
    "green_telemetry_record_v1": {
      "description": "TP-101 canonical GreenTelemetry Record (GTR). schema_version MUST be 1.0.",
      "type": "object",
      "properties": {
        "gtr_id": { "$ref": "#/definitions/uuid_v4" },
        "source_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "source_type": { "$ref": "#/definitions/source_type" },
        "measurement_type": { "$ref": "#/definitions/measurement_type" },
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 16 },
        "timestamp": { "$ref": "#/definitions/iso8601_timestamp" },
        "location": { "$ref": "#/definitions/geo_point" },
        "attestations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/attestation" }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "schema_version": { "type": "string", "const": "1.0" },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "description": "Greenledger project slug; tegalid extension."
        },
        "binding_id": {
          "type": "string",
          "minLength": 1,
          "description": "Edge instance id; tegalid extension."
        },
        "zk_evidence": { "$ref": "#/definitions/zk_evidence" }
      },
      "required": [
        "gtr_id",
        "source_id",
        "source_type",
        "measurement_type",
        "value",
        "unit",
        "timestamp",
        "attestations",
        "schema_version"
      ],
      "additionalProperties": false
    },
    "sovereign_node_telemetry": {
      "description": "Legacy v1.x signed node envelope (Phase 1 producers). Normalized to GTR v1 at the oracle.",
      "allOf": [
        {
          "type": "object",
          "properties": {
            "node_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "Maps to GTR source_id. Tegalid DID in production."
            },
            "project_id": {
              "type": "string",
              "minLength": 1,
              "description": "Greenledger project slug; must match tegalid NodeBinding when present."
            },
            "binding_id": {
              "type": "string",
              "minLength": 1,
              "description": "Edge instance id within project; must match tegalid NodeBinding when present."
            },
            "timestamp": { "type": "integer", "minimum": 0 },
            "system_type": {
              "enum": ["ZEEGATE_TELECOM", "BYTENERGY_UTILITY"]
            },
            "metrics": { "type": "object" },
            "location": { "$ref": "#/definitions/geo_point" },
            "zk_evidence": { "$ref": "#/definitions/zk_evidence" },
            "signature": {
              "type": "string",
              "pattern": "^hmac-sha256:[0-9a-f]{64}$"
            }
          },
          "required": ["node_id", "timestamp", "system_type", "metrics", "signature"],
          "additionalProperties": false
        },
        {
          "oneOf": [
            { "$ref": "#/definitions/zeegate_telemetry" },
            { "$ref": "#/definitions/bytenergy_telemetry" }
          ]
        }
      ]
    },
    "zk_evidence": {
      "description": "Zero-knowledge proof over final public evidence sent to the Greenledger (telemetry, CDR summary, etc.). Private witness stays off-chain.",
      "type": "object",
      "properties": {
        "scheme": { "type": "string", "minLength": 1 },
        "circuit_id": { "type": "string", "minLength": 1 },
        "evidence_kind": {
          "enum": ["GREETELEMETRY", "CDR", "AGGREGATE", "ASSET_RETIREMENT"]
        },
        "public_inputs_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "commitment": {
          "type": "string",
          "pattern": "^[0-9a-f]+$"
        },
        "proof": {
          "type": "string",
          "pattern": "^[0-9a-f]+$"
        }
      },
      "required": [
        "scheme",
        "circuit_id",
        "evidence_kind",
        "public_inputs_hash",
        "commitment",
        "proof"
      ],
      "additionalProperties": false
    },
    "zeegate_telemetry": {
      "description": "Zerocell Zeegate DePIN — telecom bandwidth from gsm2sip, SIP/media, and AnyFi WiFi relay.",
      "type": "object",
      "properties": {
        "system_type": { "const": "ZEEGATE_TELECOM" },
        "metrics": {
          "type": "object",
          "properties": {
            "telecom_bandwidth_bytes": { "type": "integer", "minimum": 0 }
          },
          "required": ["telecom_bandwidth_bytes"],
          "additionalProperties": false
        }
      },
      "required": ["system_type", "metrics"]
    },
    "bytenergy_telemetry": {
      "description": "Bytenergy Utility — prosumer and grid-adjacent energy generation telemetry.",
      "type": "object",
      "properties": {
        "system_type": { "const": "BYTENERGY_UTILITY" },
        "metrics": {
          "type": "object",
          "properties": {
            "energy_generation_kwh": { "type": "number", "minimum": 0 }
          },
          "required": ["energy_generation_kwh"],
          "additionalProperties": false
        }
      },
      "required": ["system_type", "metrics"]
    }
  }
}
