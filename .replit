modules = ["python-3.11"]

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8090
externalPort = 3000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Mint Worker"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Soak Watch (24h)"

[[workflows.workflow]]
name = "Mint Worker"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/sovereign-ecosystem && TEGALCHAIN_IDENTITY_MODE=tegalid TEGALCHAIN_REQUIRE_BEARER=1 TEGALID_BINDINGS_FILE=$(pwd)/tegalchain/data/tegalid_bindings.example.json TEGALCHAIN_MINT_QUEUE_DB=$(pwd)/tegalchain/data/mint_queue.db TEGALCHAIN_OUTBOX_DIR=$(pwd)/tegalchain/data/outbox TEGALCHAIN_SUBMITTER_BACKEND=mock python3 -m integrations.mint_worker"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Soak Watch (24h)"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/sovereign-ecosystem && REPLIT_SOAK_HOURS=24 bash scripts/phase7-soak-watch.sh 20 30"

[workflows.workflow.metadata]
outputType = "console"
