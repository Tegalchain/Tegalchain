<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ZeeGate Dashboard"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="24dp"/>

        <!-- System Requirements Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="System Requirements"
                    android:textStyle="bold"
                    android:textColor="#666666"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/status_uid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="System UID: Checking..."
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/status_ksu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="KernelSU: Checking..."
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/status_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Root Access: Checking..."
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/status_permissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Permissions: Checking..." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Components Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active Components"
                    android:textStyle="bold"
                    android:textColor="#666666"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/status_oboe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Oboe Engine: Checking..."
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/status_blockchain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Blockchain: Checking..." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Onboarding Instruction Card (Hidden if everything is OK) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/onboarding_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#FFF3E0"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Setup Required"
                    android:textStyle="bold"
                    android:textColor="#E65100"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/onboarding_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Please follow the steps above to enable the gateway."
                    android:textColor="#333333"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
